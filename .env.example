# انسخ هذا الملف باسم .env واملأ القيم الحقيقية (لا تشارك .env مع أحد)

# رابط قاعدة بيانات Postgres (تحصل عليه مجاناً من Neon.tech أو Supabase)
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# نص سري عشوائي لتوقيع جلسات دخول الإدارة - غيّره لأي نص طويل عشوائي
JWT_SECRET=غيّر-هذا-إلى-نص-عشوائي-طويل-وسري

# بيانات أول حساب إدارة (تُستخدم مرة واحدة فقط عند تشغيل npm run init-db)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=غيّر-هذه-كلمة-المرور

PORT=3000
